# Frontend env example
# (Vite expects variables to start with VITE_)
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=capstonephaseb-ftt
VITE_FIREBASE_STORAGE_BUCKET=capstonephaseb-ftt.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID

# Functions env (set in terminal, not used directly by frontend)
# export GEMINI_API_KEY=your_real_gemini_key
